.header-container {
    padding-left: 6px;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    margin-bottom: 10px;
}

.title-label {
    -unity-font-style: bold;
    font-size: 20px;
    margin-bottom: 4px; /* no negative values allowed */
}

.subtitle-label {
    font-size: 12px;
    color: #999999;
    margin-bottom: 10px;
}

.section {
    border-top-width: 1px;
    border-top-color: rgba(85,85,85,1); /* 8-digit RGBA */
    border-top-style: solid;
    padding-top: 12px;
    margin-top: 12px;
}

.section-title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 6px;
}

.footer {
    margin-top: 20px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(33,33,33,1);/* alpha-supported */
    border-top-style: solid;
    flex-direction: row;
    justify-content: space-between;
}
